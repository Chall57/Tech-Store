{
  "name": "ecommerce-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e --host localhost --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cypress run --browser edge --spec \"cypress/e2e/CRUD Cliente/*.cy.ts,cypress/e2e/testes/{09,10,11,12,13,14}-*.cy.ts\"",
    "test:e2e:open": "cypress open --e2e --browser edge --config \"specPattern=cypress/e2e/CRUD Cliente/*.cy.ts\"",
    "test:e2e:regressao": "cypress run",
    "test:e2e:pedido": "cypress run --browser edge --spec \"cypress/e2e/criacao-pedido/*.cy.ts\"",
    "test:e2e:pedido:completo": "cypress run --browser edge --spec \"cypress/e2e/criacao-pedido/00-fluxo-completo.cy.ts\"",
    "test:e2e:pedido:open": "cypress open --e2e --browser edge --config \"specPattern=cypress/e2e/criacao-pedido/*.cy.ts\"",
    "test:e2e:vendas": "cypress run --browser edge --spec \"cypress/e2e/gestao-vendas/*.cy.ts\"",
    "test:e2e:vendas:completo": "cypress run --browser edge --spec \"cypress/e2e/gestao-vendas/00-venda-completa.cy.ts\"",
    "test:e2e:vendas:separados": "cypress run --browser edge --spec \"cypress/e2e/gestao-vendas/0[1-9]-*.cy.ts,cypress/e2e/gestao-vendas/1[0-2]-*.cy.ts\"",
    "test:e2e:vendas:open": "cypress open --e2e --browser edge --config \"specPattern=cypress/e2e/gestao-vendas/*.cy.ts\"",
    "test:e2e:apresentacao": "cypress run --browser edge --spec \"cypress/e2e/CRUD Cliente/*.cy.ts,cypress/e2e/testes/{09,10,11,12,13,14}-*.cy.ts\"",
    "test:e2e:cliente": "cypress run --browser edge --spec \"cypress/e2e/CRUD Cliente/*.cy.ts\"",
    "test:e2e:crud:completo": "cypress run --browser edge --spec \"cypress/e2e/CRUD Cliente/00-cliente-crud-completo.cy.ts\"",
    "test:e2e:crud": "cypress run --browser edge --spec \"cypress/e2e/CRUD Cliente/0[1-5]-*.cy.ts\"",
    "test:e2e:apresentacao:open": "cypress open --e2e --browser edge --config \"specPattern=cypress/e2e/CRUD Cliente/*.cy.ts\"",
    "test:e2e:cliente:open": "cypress open --e2e --browser edge --config \"specPattern=cypress/e2e/CRUD Cliente/*.cy.ts\"",
    "test:e2e:testes": "cypress run --browser edge --spec \"cypress/e2e/testes/*.cy.ts\"",
    "test:e2e:testes:open": "cypress open --e2e --browser edge --config \"specPattern=cypress/e2e/testes/*.cy.ts\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.101.4",
    "echarts": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "cypress": "^16.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
